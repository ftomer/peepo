{
  "sceneId": "rainbow_meadow",
  "image": "rawimages/rainbow_meadow/background.jpeg",
  "summary": "A sunlit storybook meadow under a huge double rainbow, with a pink turreted castle on a distant hill. A big shade tree with a flat-topped stump stands at the left behind a low rail fence, a bed of tulips and a red-checked picnic blanket sit on the open lawn in front of it, and a loaded wheelbarrow rests beside a stone wishing well in the middle distance. A stream winds in from the centre and curves off to the right, crossed by a small arched wooden bridge and edged with stepping stones, grey rocks and a dark bush. On the right bank a hay bale, a red-and-white striped market stall and a stack of terracotta pots crowd the near ground, and a dirt path and open lawn run along the whole bottom of the frame.",
  "theme": "storybook meadow",
  "camera": "eye level over gently rolling grass, mild wide-angle; the horizon with the hills and castle sits just above the frame's middle third, and everything below it - fence, tree, well, cart, stream, stall - grows larger toward the bottom edge",
  "lighting": {
    "ambient": "bright, even sunny daylight typical of flat clip-art shading; soft rounded shadows pool directly under the fence, cart, well and stump, and nothing in the meadow reads as truly dark",
    "keySources": [
      {
        "id": "sun",
        "at": [
          0.08,
          0.04
        ],
        "color": "warm daylight",
        "strength": "medium"
      }
    ],
    "shadowDirection": [
      0.08,
      0.97
    ],
    "notes": "Shading is flat and cheerful with no strong directional key, so props keep their own drawn shading rather than needing to match a rake of light. The only genuinely dark pockets are under the tree canopy, inside the cart bed and under the streamside bush."
  },
  "palette": {
    "dominant": [
      "#6fc24b",
